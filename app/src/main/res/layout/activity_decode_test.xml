<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/watch_pad"
    android:paddingTop="@dimen/watch_pad_tight"
    android:paddingBottom="@dimen/watch_pad_tight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_control_button"
            android:gravity="center"
            android:text="@string/back"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/decode_test_title"
            android:textColor="@color/accent"
            android:textSize="@dimen/watch_title"
            android:textStyle="bold" />
    </LinearLayout>

    <TextureView
        android:id="@+id/texture"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="6dp"
        android:background="@android:color/black" />

    <TextView
        android:id="@+id/statusLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/decode_test_hint"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/watch_meta" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnH264360"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/accent"
                android:minHeight="0dp"
                android:text="@string/decode_test_h264_360"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta" />

            <Button
                android:id="@+id/btnH264480"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/accent"
                android:minHeight="0dp"
                android:text="@string/decode_test_h264_480"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta" />

            <Button
                android:id="@+id/btnHevc360"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/episode_normal"
                android:minHeight="0dp"
                android:text="@string/decode_test_hevc_360"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta" />

            <Button
                android:id="@+id/btnHevc480"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/episode_normal"
                android:minHeight="0dp"
                android:text="@string/decode_test_hevc_480"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta" />

            <Button
                android:id="@+id/btnHevcHw"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/episode_normal"
                android:minHeight="0dp"
                android:text="@string/decode_test_hevc_hw"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/decode_test_caps"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/watch_meta" />

            <TextView
                android:id="@+id/capsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="1dp"
                android:textColor="@color/text_secondary"
                android:textSize="9sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
