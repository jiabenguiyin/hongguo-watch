<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/watch_pad"
    android:paddingTop="@dimen/watch_pad_tight"
    android:paddingBottom="@dimen/watch_pad_tight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_control_button"
            android:gravity="center"
            android:text="@string/back"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/seriesTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_title"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/favoriteButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_control_button"
            android:contentDescription="@string/cd_favorite"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_favorite_border" />
    </LinearLayout>

    <TextView
        android:id="@+id/seriesIntro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/watch_meta" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/episodesLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/episodes"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/watch_meta" />

        <TextView
            android:id="@+id/continueButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_quality_chip"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingHorizontal="12dp"
            android:text="@string/continue_watch"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_body"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/episodeGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingBottom="4dp" />

                <ProgressBar
                    android:id="@+id/loading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/errorView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_panel"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/watch_body"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/relatedLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/related_section"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/watch_meta"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/relatedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
