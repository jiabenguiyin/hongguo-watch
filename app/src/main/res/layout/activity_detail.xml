<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/watch_pad"
    android:paddingTop="@dimen/watch_pad_tight"
    android:paddingBottom="@dimen/watch_pad_tight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_control_button"
            android:gravity="center"
            android:text="@string/back"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/detail_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_title"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/cover"
                    android:layout_width="72dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_cover"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/seriesTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_title"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/tagRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/episodesMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/watch_meta" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/ratingText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/rating_good"
                            android:textSize="@dimen/watch_meta"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/heatText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/heat"
                            android:textSize="@dimen/watch_meta"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/seriesIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/watch_meta" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playNowButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_play_now"
                    android:gravity="center"
                    android:text="@string/play_now"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cacheAction"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_favorite_action"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/download_action"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body" />

                <TextView
                    android:id="@+id/favoriteAction"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_favorite_action"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/favorite"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/downloadBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/downloadSeasonButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_play_now"
                    android:gravity="center"
                    android:text="@string/download_season"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_meta"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/downloadSelectedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:gravity="center"
                    android:text="@string/download_selected"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_meta"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/downloadCancelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_control_button"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/download_cancel"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/watch_meta" />
            </LinearLayout>

            <TextView
                android:id="@+id/downloadHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/download_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/watch_meta"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/episodesLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/episodes"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/expandToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_control_button"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="@string/episode_expand"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/watch_meta"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/orderToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_control_button"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="@string/episode_order_asc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/watch_meta" />

                <TextView
                    android:id="@+id/continueButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_quality_chip"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/continue_watch"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_meta"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/episodeRangeScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/episodeRangeRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="48dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/episodeGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:paddingBottom="4dp" />

                <ProgressBar
                    android:id="@+id/loading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/errorView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_panel"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/watch_body"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/relatedLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/related_section"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/watch_meta"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/relatedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 兼容旧绑定：隐藏收藏图标按钮 -->
    <ImageButton
        android:id="@+id/favoriteButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="@string/cd_favorite" />
</LinearLayout>
