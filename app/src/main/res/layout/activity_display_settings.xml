<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/displayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/displayToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/watch_pad_tight">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="@dimen/watch_control_h"
            android:layout_height="@dimen/watch_control_h"
            android:background="@drawable/bg_control_button"
            android:contentDescription="@string/settings_back"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/back"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/watch_pad"
            android:layout_weight="1"
            android:text="@string/display_settings_title"
            android:textColor="@color/accent"
            android:textSize="@dimen/watch_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/toolbarClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/watch_pad"
            android:contentDescription="@string/cd_toolbar_clock"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_meta"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/displayScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/watch_pad">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_block"
                android:orientation="vertical"
                android:padding="@dimen/watch_pad">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/display_shape"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/watch_pad_tight"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/shapeAuto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_quality_chip"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="@dimen/watch_control_h"
                        android:text="@string/display_shape_auto"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_meta" />

                    <TextView
                        android:id="@+id/shapeRound"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_quality_chip"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="@dimen/watch_control_h"
                        android:text="@string/display_shape_round"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_meta" />

                    <TextView
                        android:id="@+id/shapeRectangle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_quality_chip"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="@dimen/watch_control_h"
                        android:text="@string/display_shape_rectangle"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_meta" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/previewArea"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="@dimen/watch_pad"
                android:background="@drawable/bg_setting_block">

                <LinearLayout
                    android:id="@+id/previewCard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_panel"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/watch_pad">

                    <TextView
                        android:id="@+id/previewTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/display_preview_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/previewBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/display_preview_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/watch_meta" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/watch_pad"
                android:background="@drawable/bg_setting_block"
                android:orientation="vertical"
                android:padding="@dimen/watch_pad">

                <TextView
                    android:id="@+id/scaleValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/scaleSlider"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body" />

                <SeekBar
                    android:id="@+id/scaleSlider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/watch_control_h"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <TextView
                    android:id="@+id/textValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/textSlider"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body" />

                <SeekBar
                    android:id="@+id/textSlider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/watch_control_h"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/watch_pad"
                android:background="@drawable/bg_setting_block"
                android:orientation="vertical"
                android:padding="@dimen/watch_pad">

                <TextView
                    android:id="@+id/horizontalValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/horizontalSlider"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body" />

                <SeekBar
                    android:id="@+id/horizontalSlider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/watch_control_h"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <TextView
                    android:id="@+id/verticalValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/verticalSlider"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body" />

                <SeekBar
                    android:id="@+id/verticalSlider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/watch_control_h"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/resetButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/watch_pad"
                android:background="@drawable/bg_quality_chip"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/watch_control_h"
                android:paddingHorizontal="@dimen/watch_pad"
                android:text="@string/display_reset"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_body" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/watch_pad_tight"
        android:background="@drawable/bg_play_now"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/watch_control_h"
        android:paddingHorizontal="@dimen/watch_pad"
        android:text="@string/display_apply"
        android:textColor="@color/bg"
        android:textSize="@dimen/watch_body"
        android:textStyle="bold" />
</LinearLayout>
