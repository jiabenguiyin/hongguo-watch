<?xml version="1.0" encoding="utf-8"?>
<!--
  与设置 / 显示设置同一套 chrome：
  root(padding) → topChrome → content(weight=1) → bottomChrome(新建|编辑底栏)。
  底栏是 Scroll/List 的兄弟，不叠在列表上；四角交给 WatchUi.applySafePadding。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/foldersRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/watch_pad"
    android:paddingTop="@dimen/watch_pad_tight"
    android:paddingBottom="@dimen/watch_pad_tight">

    <!-- 顶栏 chrome：对齐 settingsToolbar（44dp 返回 + 标题 + 时钟） -->
    <LinearLayout
        android:id="@+id/foldersTopChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/foldersToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_control_button"
                android:gravity="center"
                android:text="@string/back"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/titleView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/favorites_folders_title"
                android:textColor="@color/accent"
                android:textSize="@dimen/watch_title"
                android:textStyle="bold" />

            <!-- 夹内条目编辑入口：顶栏与「管理」并排 -->
            <TextView
                android:id="@+id/editButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_control_button"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/library_edit"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta"
                android:visibility="gone" />

            <TextView
                android:id="@+id/manageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_control_button"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/favorites_folder_manage"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta"
                android:visibility="gone" />

            <TextView
                android:id="@+id/toolbarClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/cd_toolbar_clock"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/watch_meta"
            android:visibility="gone" />

        <!-- 批量编辑条：全选 | 已选 N | 完成 -->
        <LinearLayout
            android:id="@+id/editBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/selectAllButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/library_select_all"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/selectedCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/watch_meta" />

            <TextView
                android:id="@+id/editDoneButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/library_edit_done"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/folderList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/watch_pad" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/emptyPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/favorites_folders_empty"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/watch_body" />

            <TextView
                android:id="@+id/emptyAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_control_button"
                android:gravity="center"
                android:minWidth="120dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/favorites_folder_create"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 编辑底栏：与显示设置 saveButton 同为 content 下方兄弟（不再叠在列表上） -->
    <LinearLayout
        android:id="@+id/itemActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/watch_pad_tight"
        android:background="@color/bg_elevated"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/moveBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="@dimen/watch_control_h"
            android:paddingVertical="6dp"
            android:text="@string/favorites_folder_move_to"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_meta"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/deleteBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="@dimen/watch_control_h"
            android:paddingVertical="6dp"
            android:text="@string/library_delete"
            android:textColor="@color/accent"
            android:textSize="@dimen/watch_meta"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 新建/添加：对齐 display saveButton -->
    <TextView
        android:id="@+id/createButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/watch_pad_tight"
        android:background="@drawable/bg_control_button"
        android:gravity="center"
        android:minHeight="@dimen/watch_control_h"
        android:paddingHorizontal="@dimen/watch_pad"
        android:text="@string/favorites_folder_create_plus"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/watch_body"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
