<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/watch_pad"
    android:paddingTop="@dimen/watch_pad_tight">

    <LinearLayout
        android:id="@+id/brandRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/brandIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/brandTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_title"
            android:textStyle="bold" />

        <!-- 库内搜索：顶栏时钟左侧（官方截图位） -->
        <ImageView
            android:id="@+id/librarySearchToggle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/library_search"
            android:padding="5dp"
            android:src="@drawable/ic_search"
            android:visibility="gone" />

        <!-- 手表顶栏时钟：首页 / 库页共用 -->
        <TextView
            android:id="@+id/toolbarClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/cd_toolbar_clock"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_meta"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 可用面：收藏 / 历史 / 离线。点赞·预约·追更未打通前不进分段。 -->
    <LinearLayout
        android:id="@+id/librarySegmentRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_panel"
        android:orientation="horizontal"
        android:padding="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/segmentFavorites"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_top_tab_active"
            android:gravity="center"
            android:text="@string/segment_favorites"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_meta"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/segmentHistory"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_top_tab_idle"
            android:gravity="center"
            android:text="@string/segment_history"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/watch_meta" />

        <TextView
            android:id="@+id/segmentOffline"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_top_tab_idle"
            android:gravity="center"
            android:text="@string/segment_offline"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/watch_meta" />
    </LinearLayout>

    <!-- 收藏内筛选：全部 / 收藏夹（云端；手表精简，不做真人剧/漫剧） -->
    <LinearLayout
        android:id="@+id/favoritesFilterRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/favoritesFilterAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_top_tab_active"
            android:gravity="center"
            android:minHeight="@dimen/watch_chip_min_h"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/favorites_filter_all"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_meta"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/favoritesFilterFolders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_top_tab_idle"
            android:gravity="center"
            android:minHeight="@dimen/watch_chip_min_h"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/favorites_folders_title"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/watch_meta" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/librarySearchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/librarySearchInput"
            android:layout_width="0dp"
            android:layout_height="@dimen/watch_control_h"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:hint="@string/library_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="@dimen/watch_meta" />

        <TextView
            android:id="@+id/librarySearchClear"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/watch_control_h"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_control_button"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingHorizontal="8dp"
            android:text="@string/library_search_clear"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_meta" />
    </LinearLayout>

    <!-- 非离线段时展示占用摘要；点按进入离线段 -->
    <TextView
        android:id="@+id/libraryCacheHook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_panel"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/watch_meta"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/homeNavScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/homeNavRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/navRecommend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_top_tab_active"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="@dimen/watch_chip_min_h"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/nav_recommend"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navRank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_top_tab_idle"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="@dimen/watch_chip_min_h"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/nav_rank"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/navCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_top_tab_idle"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="@dimen/watch_chip_min_h"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/nav_category"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/navSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_top_tab_idle"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="@dimen/watch_chip_min_h"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/nav_search"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/searchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingHorizontal="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="@dimen/watch_body" />

        <Button
            android:id="@+id/searchButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/accent"
            android:minWidth="56dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/search"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_body" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/categoryRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="2dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/pageSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/watch_meta"
        android:visibility="gone" />

    <!-- 收藏批量编辑条：全选 | 已选 N | 完成 -->
    <LinearLayout
        android:id="@+id/libraryEditBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/librarySelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/library_select_all"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_meta"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/librarySelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/watch_meta" />

        <TextView
            android:id="@+id/libraryEditDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/library_edit_done"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_meta"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/seriesList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="6dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:text="@string/empty_search"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/watch_body"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/libraryDeleteBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/bg_elevated"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/library_delete"
            android:textColor="@color/accent"
            android:textSize="@dimen/watch_body"
            android:textStyle="bold"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/mineContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/mineAccountCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_setting_block"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/watch_control_h"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_brand_mark" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/mineAccountName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/mine_account_sign_in"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/watch_body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/mineAccountHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/mine_account_cloud_hint"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/watch_meta" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        android:text="@string/setting_chevron"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mineSettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/watch_pad_tight"
                    android:background="@drawable/bg_setting_block"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/watch_control_h"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_settings_kernel" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_settings"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/watch_body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/mine_settings_summary"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/watch_meta" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        android:text="@string/setting_chevron"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/watch_tab_h"
        android:background="@drawable/bg_tab_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="2dp">

        <TextView
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_top_tab_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="0dp"
            android:text="@string/tab_home"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_top_tab_idle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="0dp"
            android:text="@string/tab_library"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_top_tab_idle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="0dp"
            android:text="@string/tab_mine"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
