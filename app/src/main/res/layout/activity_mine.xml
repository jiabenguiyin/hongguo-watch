<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mineRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/watch_pad"
    android:paddingTop="@dimen/watch_pad_tight"
    android:paddingBottom="@dimen/watch_pad_tight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="@dimen/watch_control_h"
            android:layout_height="@dimen/watch_control_h"
            android:background="@drawable/bg_control_button"
            android:gravity="center"
            android:text="@string/back"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/mineTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/watch_pad"
            android:layout_weight="1"
            android:text="@string/tab_mine"
            android:textColor="@color/accent"
            android:textSize="@dimen/watch_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/toolbarClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_toolbar_clock"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_meta"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/mineScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/accountCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_block"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_brand_mark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/accountName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/mine_account_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/accountHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/mine_account_signed_out"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/watch_meta" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_chevron"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/libraryShortcuts"
                android:layout_width="match_parent"
                android:layout_height="@dimen/watch_tab_h"
                android:layout_marginTop="@dimen/watch_pad"
                android:background="@drawable/bg_tab_bar"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/favoritesButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/mine_favorites"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_meta"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/historyButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/mine_history"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_meta"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/offlineButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/mine_offline"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_meta"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/libraryHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/watch_pad_tight"
                android:gravity="center"
                android:text="@string/mine_library_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/watch_meta" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/watch_pad"
                android:background="@drawable/bg_setting_block"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="@string/mine_settings_section"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/watch_meta"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/settingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_settings_round" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_settings"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/watch_body" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/mine_settings_hint"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/watch_meta" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_chevron"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
