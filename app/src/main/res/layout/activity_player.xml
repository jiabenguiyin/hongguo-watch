<?xml version="1.0" encoding="utf-8"?>
<!-- 手表播放页：锁定、左右亮度/音量、图标控件、可跨季连播 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- Media3 默认路径（TextureView） -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:surface_type="texture_view"
        app:resize_mode="fit"
        app:keep_content_on_player_reset="true"
        app:use_artwork="false"
        app:use_controller="false"
        app:show_buffering="never"
        app:shutter_background_color="@android:color/black" />

    <!-- IJK/FFmpeg 兼容软解路径（手表 / 低配）；默认隐藏 -->
    <TextureView
        android:id="@+id/ijkTexture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:visibility="gone" />

    <View
        android:id="@+id/gestureLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <ProgressBar
        android:id="@+id/miniProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/watch_mini_progress_h"
        android:layout_gravity="bottom"
        android:max="1000"
        android:progressDrawable="@drawable/mini_progress"
        android:visibility="gone" />

    <!-- 左侧亮度条（圆屏由代码加大 margin，避开圆弧） -->
    <LinearLayout
        android:id="@+id/brightnessMeter"
        android:layout_width="28dp"
        android:layout_height="120dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="18dp"
        android:background="@drawable/bg_side_meter"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brightness"
            android:textColor="@color/text_secondary"
            android:textSize="8sp" />

        <ProgressBar
            android:id="@+id/brightnessBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="72dp"
            android:layout_height="10dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressDrawable="@drawable/mini_progress"
            android:rotation="270" />
    </LinearLayout>

    <!-- 右侧音量条 -->
    <LinearLayout
        android:id="@+id/volumeMeter"
        android:layout_width="28dp"
        android:layout_height="120dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_side_meter"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/volume"
            android:textColor="@color/text_secondary"
            android:textSize="8sp" />

        <ProgressBar
            android:id="@+id/volumeBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="72dp"
            android:layout_height="10dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressDrawable="@drawable/mini_progress"
            android:rotation="270" />
    </LinearLayout>

    <!-- 唯一缓冲指示：勿与 PlayerView 内置 buffering 叠圈 -->
    <LinearLayout
        android:id="@+id/loadingBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="@string/loading"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_meta" />
    </LinearLayout>

    <TextView
        android:id="@+id/gestureHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/seasonBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="18dp"
        android:layout_marginBottom="52dp"
        android:background="@drawable/bg_panel"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/watch_meta"
        android:visibility="gone" />

    <!-- 锁定：左侧小解锁钮（与 lock 同侧），不盖画面；手势由代码吞掉 -->
    <ImageButton
        android:id="@+id/unlockButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="14dp"
        android:background="@drawable/bg_lock_chip"
        android:contentDescription="@string/cd_unlock"
        android:padding="11dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_unlock"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 时间+电量：随控件栏显隐；顶 padding 由 PlayerChromeInsets 避让系统栏 -->
        <LinearLayout
            android:id="@+id/playerStatusStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/statusClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_toolbar_clock"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/statusBatteryIcon"
                android:layout_width="14dp"
                android:layout_height="9dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_battery" />

            <TextView
                android:id="@+id/statusBatteryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_control_bar_top"
            android:gravity="center_vertical"
            android:minHeight="@dimen/watch_top_h"
            android:orientation="horizontal"
            android:paddingHorizontal="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_control_button"
                android:gravity="center"
                android:text="@string/back"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/playerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/qualityButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_player_pill"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingHorizontal="8dp"
                android:text="480p"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_meta" />

            <!-- 离线下载改由详情页发起；保留 id 以免旧布局绑定断裂 -->
            <TextView
                android:id="@+id/cacheButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="@string/cache_action" />

            <ImageButton
                android:id="@+id/aspectButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_control_button"
                android:contentDescription="@string/cd_aspect"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_aspect" />

            <ImageButton
                android:id="@+id/rotateButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_control_button"
                android:contentDescription="@string/cd_rotate"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_rotate" />
        </LinearLayout>

        <!-- 中区：左侧锁定 · 点按显隐（手表习惯靠左） -->
        <LinearLayout
            android:id="@+id/midControls"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageButton
                android:id="@+id/lockButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_lock_chip"
                android:contentDescription="@string/cd_lock"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_lock" />

            <View
                android:id="@+id/controlsMidTap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_control_bar_bottom"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/playerNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="@string/play_preview_notice"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/watch_meta"
                android:visibility="gone" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/watch_seek_h"
                android:max="1000"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:progressDrawable="@drawable/seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb"
                android:thumbOffset="7dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingTop="2dp">

                <TextView
                    android:id="@+id/timeCurrent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_meta" />

                <TextView
                    android:id="@+id/timeTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/watch_meta" />
            </LinearLayout>

            <!-- 稿面：选集 · 上集 · 红圆播放 · 下集 · 倍速 -->
            <LinearLayout
                android:id="@+id/bottomButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingTop="4dp">

                <TextView
                    android:id="@+id/episodesButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_player_pill"
                    android:gravity="center"
                    android:minWidth="52dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/episodes"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_meta" />

                <ImageButton
                    android:id="@+id/prevButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/watch_control_h"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/cd_prev"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_prev" />

                <ImageButton
                    android:id="@+id/playPauseButton"
                    android:layout_width="@dimen/watch_play_h"
                    android:layout_height="@dimen/watch_play_h"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_play_accent"
                    android:contentDescription="@string/cd_play"
                    android:padding="14dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_play"
                    android:tint="@null" />

                <ImageButton
                    android:id="@+id/nextButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/watch_control_h"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/cd_next"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_next" />

                <TextView
                    android:id="@+id/speedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_player_pill"
                    android:contentDescription="@string/cd_speed"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:paddingHorizontal="10dp"
                    android:text="1.0x"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_meta"
                    android:textStyle="bold" />

                <!-- 兼容旧绑定：隐藏 speedLabel -->
                <TextView
                    android:id="@+id/speedLabel"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/retryButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_quality_chip"
                android:gravity="center"
                android:text="@string/retry"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_body"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/sheetScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/qualitySheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/quality_sheet_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/quality480"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:gravity="center"
                    android:text="480p"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quality720"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:gravity="center"
                    android:text="720p"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quality1080"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:gravity="center"
                    android:text="1080p"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aspectSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/aspect_sheet_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/aspectFit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:gravity="center"
                    android:text="@string/aspect_fit"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/aspectFill"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:gravity="center"
                    android:text="@string/aspect_fill"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/aspectStretch"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:gravity="center"
                    android:text="@string/aspect_stretch"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/aspectZoomReset"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_control_button"
                android:gravity="center"
                android:text="@string/zoom_reset"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/watch_meta" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/speedSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/speed_sheet_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_body" />

            <!-- 两行排布，保证手表小屏触控 ≥40dp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/speed075"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:gravity="center"
                    android:text="0.75x"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/speed100"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:gravity="center"
                    android:text="1.0x"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/speed125"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:gravity="center"
                    android:text="1.25x"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/speed150"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:gravity="center"
                    android:text="1.5x"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/speed200"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_quality_chip"
                    android:gravity="center"
                    android:text="2.0x"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/episodesSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="6dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/episodesSheetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/episodes"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_body"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episodePicker"
                android:layout_width="match_parent"
                android:layout_height="148dp"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="2dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
