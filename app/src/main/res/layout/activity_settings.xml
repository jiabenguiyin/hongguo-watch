<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/watch_pad"
    android:paddingTop="@dimen/watch_pad_tight"
    android:paddingBottom="@dimen/watch_pad_tight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_control_button"
            android:gravity="center"
            android:text="@string/back"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/tab_settings"
            android:textColor="@color/accent"
            android:textSize="@dimen/watch_title"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_block"
                android:orientation="vertical"
                android:padding="8dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/wifiOnlySwitch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/wifi_only"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/roundAdaptSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/round_adapt"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body" />

                <TextView
                    android:id="@+id/roundAdaptHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/round_adapt_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/watch_meta" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/max_quality"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/watch_meta" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/quality480"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_quality_chip"
                        android:gravity="center"
                        android:text="480p"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/quality720"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_quality_chip"
                        android:gravity="center"
                        android:text="720p"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/quality1080"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_quality_chip"
                        android:gravity="center"
                        android:text="1080p"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/watch_body"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 保留 Spinner 兼容旧绑定；隐藏，逻辑已切到芯片 -->
                <Spinner
                    android:id="@+id/qualitySpinner"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_setting_block"
                android:orientation="vertical"
                android:padding="8dp">

                <Button
                    android:id="@+id/clearHistoryButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:backgroundTint="@color/episode_normal"
                    android:minHeight="0dp"
                    android:text="@string/clear_history"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body" />

                <Button
                    android:id="@+id/clearCacheButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/episode_normal"
                    android:minHeight="0dp"
                    android:text="@string/clear_cache"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/watch_body" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/about_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/watch_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/about_body"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/watch_meta" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
