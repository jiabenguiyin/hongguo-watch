<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/watch_pad"
    android:paddingTop="@dimen/watch_pad_tight"
    android:paddingBottom="@dimen/watch_pad_tight">

    <LinearLayout
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_control_button"
            android:contentDescription="@string/settings_back"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/back"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/tab_settings"
            android:textColor="@color/accent"
            android:textSize="@dimen/watch_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/toolbarClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/cd_toolbar_clock"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/watch_meta"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/watch_pad">

            <LinearLayout
                style="@style/Widget.HongguoWatch.SettingsGroup">

                <LinearLayout
                    android:id="@+id/displaySettingsButton"
                    style="@style/Widget.HongguoWatch.SettingsAction">

                    <ImageView
                        style="@style/Widget.HongguoWatch.SettingsIcon"
                        android:src="@drawable/ic_settings_round" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsRowTitle"
                        android:text="@string/display_settings_title" />

                    <TextView
                        android:id="@+id/displaySettingsStatus"
                        style="@style/Widget.HongguoWatch.SettingsValue" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsArrow" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Widget.HongguoWatch.SettingsHeading"
                android:text="@string/settings_section_playback" />

            <LinearLayout
                style="@style/Widget.HongguoWatch.SettingsGroup">

                <LinearLayout style="@style/Widget.HongguoWatch.SettingsRow">

                    <ImageView
                        style="@style/Widget.HongguoWatch.SettingsIcon"
                        android:src="@drawable/ic_settings_wifi" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/wifiOnlySwitch"
                        style="@style/Widget.HongguoWatch.SettingsSwitch"
                        android:enabled="false"
                        android:text="@string/wifi_only" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/qualityButton"
                    style="@style/Widget.HongguoWatch.SettingsAction"
                    android:enabled="false">

                    <ImageView
                        style="@style/Widget.HongguoWatch.SettingsIcon"
                        android:src="@drawable/ic_settings_quality" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsRowTitle"
                        android:text="@string/max_quality" />

                    <TextView
                        android:id="@+id/qualityStatus"
                        style="@style/Widget.HongguoWatch.SettingsValue" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/playbackRouteButton"
                    style="@style/Widget.HongguoWatch.SettingsAction"
                    android:enabled="false">

                    <ImageView
                        style="@style/Widget.HongguoWatch.SettingsIcon"
                        android:src="@drawable/ic_settings_wifi" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsRowTitle"
                        android:text="@string/playback_route_label" />

                    <TextView
                        android:id="@+id/playbackRouteStatus"
                        style="@style/Widget.HongguoWatch.SettingsValue" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsArrow" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.HongguoWatch.SettingsHint"
                    android:text="@string/playback_route_hint" />

                <LinearLayout
                    android:id="@+id/playbackProxyButton"
                    style="@style/Widget.HongguoWatch.SettingsAction"
                    android:enabled="false">

                    <ImageView
                        style="@style/Widget.HongguoWatch.SettingsIcon"
                        android:src="@drawable/ic_settings_wifi" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsRowTitle"
                        android:text="@string/playback_proxy_label" />

                    <TextView
                        android:id="@+id/playbackProxyStatus"
                        style="@style/Widget.HongguoWatch.SettingsValue" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsArrow" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.HongguoWatch.SettingsHint"
                    android:text="@string/playback_proxy_hint" />

                <LinearLayout style="@style/Widget.HongguoWatch.SettingsRow">

                    <ImageView
                        style="@style/Widget.HongguoWatch.SettingsIcon"
                        android:src="@drawable/ic_settings_screen_off" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/screenOffContinueSwitch"
                        style="@style/Widget.HongguoWatch.SettingsSwitch"
                        android:enabled="false"
                        android:text="@string/screen_off_continue" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.HongguoWatch.SettingsHint"
                    android:text="@string/settings_screen_off_hint" />

                <LinearLayout
                    android:id="@+id/episodeWheelRow"
                    style="@style/Widget.HongguoWatch.SettingsRow"
                    android:visibility="gone">

                    <ImageView
                        style="@style/Widget.HongguoWatch.SettingsIcon"
                        android:src="@drawable/ic_next" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/episodeWheelSwitch"
                        style="@style/Widget.HongguoWatch.SettingsSwitch"
                        android:text="@string/settings_episode_wheel" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Widget.HongguoWatch.SettingsHeading"
                android:text="@string/settings_section_compatibility" />

            <LinearLayout
                style="@style/Widget.HongguoWatch.SettingsGroup">

                <LinearLayout
                    android:id="@+id/kernelButton"
                    style="@style/Widget.HongguoWatch.SettingsAction"
                    android:enabled="false">

                    <ImageView
                        style="@style/Widget.HongguoWatch.SettingsIcon"
                        android:src="@drawable/ic_settings_kernel" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsRowTitle"
                        android:text="@string/player_kernel_label" />

                    <TextView
                        android:id="@+id/kernelStatus"
                        style="@style/Widget.HongguoWatch.SettingsValue" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/decodeButton"
                    style="@style/Widget.HongguoWatch.SettingsAction"
                    android:enabled="false">

                    <ImageView
                        style="@style/Widget.HongguoWatch.SettingsIcon"
                        android:src="@drawable/ic_settings_decode" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsRowTitle"
                        android:text="@string/decode_path_label" />

                    <TextView
                        android:id="@+id/decodeStatus"
                        style="@style/Widget.HongguoWatch.SettingsValue" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsArrow" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Widget.HongguoWatch.SettingsHeading"
                android:text="@string/settings_section_storage" />

            <LinearLayout
                style="@style/Widget.HongguoWatch.SettingsGroup">

                <LinearLayout
                    android:id="@+id/manageOfflineButton"
                    style="@style/Widget.HongguoWatch.SettingsAction"
                    android:paddingVertical="@dimen/watch_pad_tight">

                    <ImageView
                        style="@style/Widget.HongguoWatch.SettingsIcon"
                        android:src="@drawable/ic_settings_offline" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/offline_manage"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/watch_body" />

                        <TextView
                            android:id="@+id/videoCacheUsage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/watch_meta" />
                    </LinearLayout>

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsArrow" />
                </LinearLayout>

                <TextView
                    android:id="@+id/clearHistoryButton"
                    style="@style/Widget.HongguoWatch.SettingsTextAction"
                    android:text="@string/settings_clear_watch_history" />

                <TextView
                    android:id="@+id/clearCacheButton"
                    style="@style/Widget.HongguoWatch.SettingsTextAction"
                    android:text="@string/settings_clear_temporary_cache" />
            </LinearLayout>

            <TextView
                style="@style/Widget.HongguoWatch.SettingsHeading"
                android:text="@string/settings_section_help" />

            <LinearLayout
                style="@style/Widget.HongguoWatch.SettingsGroup">

                <LinearLayout
                    android:id="@+id/checkUpdateButton"
                    style="@style/Widget.HongguoWatch.SettingsAction">

                    <ImageView
                        style="@style/Widget.HongguoWatch.SettingsIcon"
                        android:src="@drawable/ic_settings_update" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsRowTitle"
                        android:text="@string/check_update" />

                    <TextView
                        android:id="@+id/versionLabel"
                        style="@style/Widget.HongguoWatch.SettingsValue" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsArrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/uploadDiagButton"
                    style="@style/Widget.HongguoWatch.SettingsAction">

                    <ImageView
                        style="@style/Widget.HongguoWatch.SettingsIcon"
                        android:src="@drawable/ic_settings_diag" />

                    <TextView
                        style="@style/Widget.HongguoWatch.SettingsRowTitle"
                        android:text="@string/upload_diagnostics" />

                    <TextView style="@style/Widget.HongguoWatch.SettingsArrow" />
                </LinearLayout>

                <TextView
                    android:id="@+id/qqGroupLabel"
                    style="@style/Widget.HongguoWatch.SettingsTextAction"
                    android:text="@string/qq_group" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
