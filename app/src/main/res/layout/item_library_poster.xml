<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="2dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/posterCover"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@drawable/bg_cover"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- 封面底边观看进度（贴齐封面下沿，不落在标题下） -->
        <ProgressBar
            android:id="@+id/posterProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressDrawable="@drawable/cover_progress"
            android:visibility="gone" />

        <TextView
            android:id="@+id/recentWatchingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="3dp"
            android:background="@drawable/bg_recent_watching_badge"
            android:includeFontPadding="false"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:text="@string/history_recent_watching"
            android:textColor="@color/text_primary"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/updateBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="3dp"
            android:background="@drawable/bg_update_badge"
            android:includeFontPadding="false"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:text="@string/chase_badge"
            android:textColor="@color/text_primary"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/posterCheck"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_poster_check"
            android:contentDescription="@null"
            android:padding="3dp"
            android:src="@drawable/ic_check_white"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/posterTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/posterMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />
</LinearLayout>
