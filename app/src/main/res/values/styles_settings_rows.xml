<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.HongguoWatch.SettingsHeading" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">@dimen/watch_meta</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.HongguoWatch.SettingsGroup" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_setting_block</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.HongguoWatch.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/watch_control_h</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">8dp</item>
    </style>

    <style name="Widget.HongguoWatch.SettingsAction" parent="Widget.HongguoWatch.SettingsRow">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.HongguoWatch.SettingsIcon" parent="">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Widget.HongguoWatch.SettingsRowTitle" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/watch_body</item>
    </style>

    <style name="Widget.HongguoWatch.SettingsValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:maxWidth">76dp</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/watch_meta</item>
    </style>

    <style name="Widget.HongguoWatch.SettingsArrow" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:text">@string/setting_chevron</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.HongguoWatch.SettingsSwitch" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">@dimen/watch_control_h</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/watch_body</item>
    </style>

    <style name="Widget.HongguoWatch.SettingsTextAction" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/watch_control_h</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">34dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/watch_body</item>
    </style>

    <style name="Widget.HongguoWatch.SettingsHint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">34dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/watch_meta</item>
    </style>
</resources>
