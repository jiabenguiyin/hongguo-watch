# 复制为 .env 后按需修改。手表设置 → 播放代理 填 http://<主机>:PORT + 令牌。

PORT=8787
BIND=0.0.0.0
HONGGUO_PLAYBACK_PROXY_TOKEN=change-me

# 上游域名（接口变更时改这里；留空=内置默认）
# PROXY_REGISTER_HOST=https://log5-applog-lf.fqnovel.com
# PROXY_PRELOAD_HOST=reading.snssdk.com
# PROXY_MODEL_HOSTS=api5-normal-sinfonlinea.fqnovel.com,api5-normal-sinfonlineb.fqnovel.com,api5-normal-hl.fqnovel.com,api5-normal-lf.fqnovel.com
# PROXY_VIDEO_MODEL_HOSTS=api5-normal-sinfonlinea.fqnovel.com,api5-normal-sinfonlinec.fqnovel.com
# PROXY_VIDEO_TAB_HOST=api5-normal-sinfonlineb.fqnovel.com

# 超时（秒）
# PROXY_STREAM_DEADLINE_SEC=14
# PROXY_CONNECT_TIMEOUT_SEC=12
# PROXY_READ_TIMEOUT_SEC=20

# MetaSec / unidbg（可选；无私有 .so 时默认 PlayerSigner/Medusa V5）
# METASEC_HOME=/opt/hongguo-playback-proxy/metasec
# METASEC_BACKEND=unicorn2
# METASEC_DATA=/opt/hongguo-playback-proxy/metasec/msdata
# METASEC_DISABLE=1
# JAVA_TOOL_OPTIONS=-Xms64m -Xmx384m
