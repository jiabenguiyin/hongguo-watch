[Unit]
Description=Hongguo playback signing proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proxy
Group=proxy
WorkingDirectory=/opt/hongguo-playback-proxy/proxy
EnvironmentFile=-/opt/hongguo-playback-proxy/env
ExecStart=/opt/hongguo-playback-proxy/proxy/bin/proxy
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# 1 GiB VPS 建议：JAVA_TOOL_OPTIONS=-Xms64m -Xmx384m 且配置 swap

[Install]
WantedBy=multi-user.target
