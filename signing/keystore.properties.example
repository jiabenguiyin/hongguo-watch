# Optional production signing. Copy to keystore.properties (gitignored) and fill in.
# Without this file (and without WATCH_RELEASE_*), assembleRelease uses
# signing/debug.keystore — the same unified cert as assembleDebug / GitHub Releases.
# Paths may be absolute or relative to the repository root.
storeFile=/absolute/path/to/hongguo-watch-release.jks
storePassword=change-me
keyAlias=hongguo_watch
keyPassword=change-me
